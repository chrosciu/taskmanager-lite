{
  "info": {
    "_postman_id": "80536b1a-1244-4093-9bc3-27791658b768",
    "name": "taskmanager-lite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "32994393"
  },
  "item": [
    {
      "name": "Create user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {\r",
              "    pm.response.to.have.status(201);    \r",
              "});\r",
              "\r",
              "pm.test(\"Location header contains user id\", function () {\r",
              "    const location = pm.response.headers.get('Location');\r",
              "    const userIdMatches = location.match(/\\/users\\/(\\d+)/);\r",
              "    pm.expect(userIdMatches.length).to.eql(2);\r",
              "    pm.collectionVariables.set(\"userId\", userIdMatches[1]);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n          \"firstName\": \"John\",\r\n          \"lastName\": \"Doe\",\r\n          \"login\": \"johndoe\",\r\n          \"password\": \"jd_password\",\r\n          \"userRole\": \"DEVELOPER\"\r\n        }"
        },
        "url": {
          "raw": "http://localhost:8080/users",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.collectionVariables.unset(\"userId\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/users/{{userId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "response": []
    }
  ]
}