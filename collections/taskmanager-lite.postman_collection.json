	"item": [
		{
			"name": "Create user",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 201\", function () {\r",
							"    pm.response.to.have.status(201);    \r",
							"});\r",
							"\r",
							"pm.test(\"Location header contains user id\", function () {\r",
							"    const location = pm.response.headers.get('Location');\r",
							"    const userIdMatches = location.match(/\\/users\\/(\\d+)/);\r",
							"    pm.expect(userIdMatches.length).to.eql(2);\r",
							"    pm.collectionVariables.set(\"userId\", userIdMatches[1]);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"firstName\": \"John\",\r\n    \"lastName\": \"Doe\",\r\n    \"login\": \"johndoe\",\r\n    \"password\": \"jd_password\",\r\n    \"userRole\": \"DEVELOPER\"\r\n}"
				},
				"url": {
					"raw": "http://localhost:8080/users",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"users"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get all users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", function () {\r",
							"    pm.response.to.have.status(200);    \r",
							"});\r",
							"\r",
							"pm.test(\"At least one user is returned\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.be.an(\"array\");\r",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/users",
